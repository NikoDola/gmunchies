# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values.
#
# TIP: for a zero-setup demo, set CMS_LOCAL_ONLY=1 (see bottom). The admin
# dashboard then reads/writes the local src/content/data.json instead of
# GitHub — you can run the whole app, including the CMS, without any GitHub
# token or OAuth app.
# ---------------------------------------------------------------------------

# --- NextAuth (admin session) ----------------------------------------------
# Generate a secret with:  openssl rand -base64 32
NEXTAUTH_SECRET=
# The site's base URL. Locally this is http://localhost:3000; in production
# set it to your deployed URL (e.g. https://your-app.vercel.app).
NEXTAUTH_URL=http://localhost:3000
# Optional: set to 1 to enable verbose NextAuth debug logs. Leave blank otherwise.
NEXTAUTH_DEBUG=

# --- Google OAuth (admin login) --------------------------------------------
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI:  {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated allowlist of Google emails permitted to sign in to /admin.
ADMIN_EMAILS=you@example.com

# --- GitHub CMS storage ----------------------------------------------------
# A token with write access to the CMS repo. Any of these names works:
# GITHUB_TOKEN / GH_TOKEN / GITHUB_PAT / GITHUB_ACCESS_TOKEN.
GITHUB_TOKEN=
# The repo the admin dashboard commits content + images to, as "owner/name".
GITHUB_REPO=owner/repo-name
# Optional: branch to commit to (defaults to "main").
GITHUB_BRANCH=main

# --- EmailJS (contact form, server-side) -----------------------------------
# Read server-side in /api/contact. Do NOT prefix these with NEXT_PUBLIC_.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
# Optional: EmailJS "private key" / access token.
EMAILJS_PRIVATE_KEY=

# --- Demo / local-only mode ------------------------------------------------
# Set to 1 to make the CMS read/write the local data.json on disk instead of
# committing to GitHub. Great for running the admin panel with zero setup.
CMS_LOCAL_ONLY=
