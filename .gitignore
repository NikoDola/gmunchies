# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# keys & archives — never commit
*.key
*.pem
id_*
*_rsa
*_ed25519
github_actions*
*.zip
*.rar
*.7z

# Claude / AI working files — internal, keep out of the public repo
CLAUDE.md
Claude-to-do.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
